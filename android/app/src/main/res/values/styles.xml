<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Opt out of Android 15's forced edge-to-edge (we target API 35); keeps the
             system insetting content below the status/nav bars as before. No effect on
             API < 35. Temporary until we target API 36 + handle insets properly. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Civic-blue status bar with light (white) icons, set in the theme so it is
             reliable (applies before JS, regardless of edge-to-edge or day/night). -->
        <item name="android:statusBarColor">#2c57a0</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Android 15 edge-to-edge opt-out (see AppTheme). This is the runtime theme. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>