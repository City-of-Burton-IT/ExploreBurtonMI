<?xml version="1.0" encoding="utf-8"?>
<!-- Explore Burton widget metadata (#65). updatePeriodMillis is clamped by
     Android to a 30-minute minimum; the provider also refreshes on its own
     ACTION_APPWIDGET_UPDATE so alerts/meetings stay reasonably current. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="70dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_explore"
    android:previewLayout="@layout/widget_explore"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
